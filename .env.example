# OCIE: Oncology Competitive Intelligence Engine
#
# No external services required. All data stored in data/*.json files
# committed to git. Just run:
#
#   npm install
#   npm run dev
#
# To regenerate lookup data from approved drug timelines:
#   npx tsx scripts/seed-benchmarks-from-approved.ts
#
# To regenerate pipeline dashboard data:
#   npx tsx scripts/fetch-pipeline-dashboard.ts --skip-fda --skip-supabase
